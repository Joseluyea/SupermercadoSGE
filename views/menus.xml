<odoo>

  <!-- Menu principal, es el que sale en la pantalla de inicio -->
  <menuitem id="menu_supermercado_root" name="Supermercado"/>

  <!-- Submenus, cada uno con la accion de su modelo -->
  <menuitem id="menu_productos"
            parent="menu_supermercado_root"
            name="Productos"
            action="action_producto"/>

  <menuitem id="menu_secciones"
            parent="menu_supermercado_root"
            name="Secciones"
            action="action_seccion"/>

  <menuitem id="menu_empleados"
            parent="menu_supermercado_root"
            name="Empleados"
            action="action_empleado"/>

  <menuitem id="menu_proveedores"
            parent="menu_supermercado_root"
            name="Proveedores"
            action="action_proveedor"/>

</odoo>
