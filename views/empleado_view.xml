<odoo>

  <!-- Vista LIST de los empleados -->
  <record id="view_empleado_list" model="ir.ui.view">
    <field name="name">supermercado.empleado.list</field>
    <field name="model">supermercado.empleado</field>
    <field name="arch" type="xml">
      <list string="Empleados">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="seccion_id"/>
        <field name="puesto"/>
        <field name="turno"/>
        <field name="jornada_completa"/>
        <field name="ultimo_fichaje"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM de cada empleado -->
  <record id="view_empleado_form" model="ir.ui.view">
    <field name="name">supermercado.empleado.form</field>
    <field name="model">supermercado.empleado</field>
    <field name="arch" type="xml">
      <form string="Empleado">
        <!-- en la cabecera va el botón que llama al método action_fichar del modelo -->
        <header>
          <button name="action_fichar" type="object" string="Fichar" class="oe_highlight"/>
        </header>
        <sheet>
          <field name="foto" widget="image" class="oe_avatar"/>
          <group>
            <group string="Datos personales">
              <field name="nombre"/>
              <field name="apellidos"/>
              <field name="dni"/>
              <field name="fecha_nacimiento"/>
              <field name="edad"/>
            </group>
            <group string="Trabajo">
              <field name="seccion_id"/>
              <field name="puesto"/>
              <field name="turno"/>
              <field name="salario"/>
              <field name="jornada_completa"/>
              <field name="ultimo_fichaje"/>
            </group>
          </group>
          <group string="Observaciones">
            <field name="observaciones" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Vista SEARCH de los empleados -->
  <record id="view_empleado_search" model="ir.ui.view">
    <field name="name">supermercado.empleado.search</field>
    <field name="model">supermercado.empleado</field>
    <field name="arch" type="xml">
      <search string="Buscar empleados">
        <field name="nombre"/>
        <field name="apellidos"/>
        <field name="dni"/>
        <field name="seccion_id"/>
        <filter name="turno_manana" string="Turno de mañana" domain="[('turno', '=', 'manana')]"/>
        <filter name="turno_tarde" string="Turno de tarde" domain="[('turno', '=', 'tarde')]"/>
        <separator/>
        <filter name="jornada_completa" string="Jornada completa" domain="[('jornada_completa', '=', True)]"/>
        <filter name="media_jornada" string="Media jornada" domain="[('jornada_completa', '=', False)]"/>
        <group>
          <filter name="agrupar_seccion" string="Sección" context="{'group_by': 'seccion_id'}"/>
          <filter name="agrupar_puesto" string="Puesto" context="{'group_by': 'puesto'}"/>
          <filter name="agrupar_turno" string="Turno" context="{'group_by': 'turno'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Acción que abre las vistas de empleado -->
  <record id="action_empleado" model="ir.actions.act_window">
    <field name="name">Empleados</field>
    <field name="res_model">supermercado.empleado</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
