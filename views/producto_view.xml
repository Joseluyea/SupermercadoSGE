<odoo>

  <!--Vista LIST de productos -->
  <record id="view_producto_list" model="ir.ui.view">
    <field name="name">supermercado.producto.list</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <list string="Productos">
        <field name="nombre"/>
        <field name="seccion_id"/>
        <field name="precio"/>
        <field name="tipo_iva"/>
        <field name="precio_final"/>
        <field name="stock"/>
        <field name="tipo_conservacion"/>
        <field name="fecha_caducidad"/>
        <field name="caducado"/>
        <field name="en_oferta"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM, la ficha de cada producto -->
  <record id="view_producto_form" model="ir.ui.view">
    <field name="name">supermercado.producto.form</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <form string="Producto">
        <sheet>
          <!-- con el wigdet image el binary se ve como foto y no como un archivo -->
          <field name="imagen" widget="image" class="oe_avatar"/>
          <!--dos group dentro de otro para que salga en dos columnas-->
          <group>
            <group string="Datos del producto">
              <field name="nombre"/>
              <field name="seccion_id"/>
              <field name="codigo_barras"/>
              <field name="tipo_conservacion"/>
              <field name="en_oferta"/>
              <!-- many2many_tags para que los proveedores salgan como etiquetas -->
              <field name="proveedor_ids" widget="many2many_tags"/>
            </group>
            <group string="Precio y stock">
              <field name="precio"/>
              <field name="tipo_iva"/>
              <field name="precio_final"/>
              <field name="stock"/>
              <field name="fecha_caducidad"/>
              <field name="caducado"/>
              <field name="fecha_alta" readonly="1"/>
            </group>
          </group>
          <!-- colspan="2" para que ocupe todo el ancho -->
          <group string="Descripción">
            <field name="descripcion" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!--Vista SEARCH, el buscador con los filtros y agrupar por -->
  <record id="view_producto_search" model="ir.ui.view">
    <field name="name">supermercado.producto.search</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <search string="Buscar productos">
        <!-- campos por los que se puede buscar -->
        <field name="nombre"/>
        <field name="codigo_barras"/>
        <field name="seccion_id"/>
        <field name="proveedor_ids"/>
        <!-- filtros, cada uno tiene un domain con la condicion que tienen que cumplir -->
        <filter name="en_oferta" string="En oferta" domain="[('en_oferta', '=', True)]"/>
        <filter name="sin_stock" string="Sin stock" domain="[('stock', '&lt;=', 0)]"/>
        <filter name="caducados" string="Caducados" domain="[('fecha_caducidad', '&lt;', 'today')]"/>
        <!-- el separator separa los filtros en grupos, los del mismo grupo se juntan con "o" y si son de grupos distintos con "y" -->
        <separator/>
        <filter name="refrigerados" string="Refrigerados" domain="[('tipo_conservacion', '=', 'refrigerado')]"/>
        <filter name="congelados" string="Congelados" domain="[('tipo_conservacion', '=', 'congelado')]"/>
        <!--para agrupar se usa group_by en el context en vez de domain-->
        <group>
          <filter name="agrupar_seccion" string="Sección" context="{'group_by': 'seccion_id'}"/>
          <filter name="agrupar_conservacion" string="Conservación" context="{'group_by': 'tipo_conservacion'}"/>
          <filter name="agrupar_iva" string="Tipo de IVA" context="{'group_by': 'tipo_iva'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Vista KANBAN, cada producto sale en una tarjeta -->
  <record id="view_producto_kanban" model="ir.ui.view">
    <field name="name">supermercado.producto.kanban</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <!-- card es lo que sale en cada tarjeta, un campo debajo de otro -->
          <t t-name="card">
            <field name="nombre"/>
            <field name="seccion_id"/>
            <span>Precio: <field name="precio_final"/> €</span>
            <span>Stock: <field name="stock"/></span>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!--Vista CALENDAR con los productos en el dia que caducan-->
  <!-- color hace que cada seccion salga de un color -->
  <!-- quick_create="0" para que al pinchar en un dia se abra el formulario entero -->
  <record id="view_producto_calendar" model="ir.ui.view">
    <field name="name">supermercado.producto.calendar</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <calendar string="Caducidades" date_start="fecha_caducidad" color="seccion_id" mode="month" quick_create="0">
        <field name="nombre"/>
        <field name="stock"/>
      </calendar>
    </field>
  </record>

  <!-- Acción que abre las vistas de producto (la usa el menu) -->
  <!-- en view_mode van las vistas que se pueden elegir, la primera es la que sale primero -->
  <record id="action_producto" model="ir.actions.act_window">
    <field name="name">Productos</field>
    <field name="res_model">supermercado.producto</field>
    <field name="view_mode">list,kanban,calendar,form</field>
  </record>

</odoo>
