<odoo>

  <!-- Vista LIST: la tabla que sale al entrar en Productos -->
  <record id="view_producto_list" model="ir.ui.view">
    <field name="name">supermercado.producto.list</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <list string="Productos">
        <field name="nombre"/>
        <field name="precio"/>
        <field name="tipo_iva"/>
        <field name="stock"/>
        <field name="tipo_conservacion"/>
        <field name="fecha_caducidad"/>
        <field name="en_oferta"/>
      </list>
    </field>
  </record>

  <!-- Vista FORM: la ficha de cada producto para crearlo o editarlo -->
  <record id="view_producto_form" model="ir.ui.view">
    <field name="name">supermercado.producto.form</field>
    <field name="model">supermercado.producto</field>
    <field name="arch" type="xml">
      <form string="Producto">
        <sheet>
          <!-- widget image para que el campo Binary se vea como una foto y no como un archivo -->
          <field name="imagen" widget="image" class="oe_avatar"/>
          <!-- dos grupos dentro de otro para que salgan en dos columnas -->
          <group>
            <group string="Datos del producto">
              <field name="nombre"/>
              <field name="codigo_barras"/>
              <field name="tipo_conservacion"/>
              <field name="en_oferta"/>
            </group>
            <group string="Precio y stock">
              <field name="precio"/>
              <field name="tipo_iva"/>
              <field name="stock"/>
              <field name="fecha_caducidad"/>
              <field name="fecha_alta" readonly="1"/>
            </group>
          </group>
          <!-- colspan="2" para que la descripcion ocupe todo el ancho y no solo media columna -->
          <group string="Descripción">
            <field name="descripcion" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción que abre las vistas de producto, la usa el menú -->
  <record id="action_producto" model="ir.actions.act_window">
    <field name="name">Productos</field>
    <field name="res_model">supermercado.producto</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
